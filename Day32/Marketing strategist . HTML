function fitScore(p, mode){ return mode==="personal" ? p.fit.personal : p.fit.business; }
function labelFor(mode){ return mode==="personal" ? "you" : "the brand"; }

function buildRoadmap(brand, mode, platforms, pillars){
  const platNames = platforms.map(p=>p.name).join(", ") || "your chosen platforms";
  const pillarNames = pillars.map(p=>p.name).join(", ") || "your chosen pillars";
  if(mode==="personal"){
    return [
      { title:"Define Your POV", goal:"Foundation", bullets:[
        `Rewrite your bio/profile on ${platNames} around one clear niche: ${brand.industry}.`,
        "Write one 'manifesto' post explaining what you believe and who you help.",
        "Follow and thoughtfully comment on 10 people in your space to get visible."
      ]},
      { title:"Build a Rhythm", goal:"Consistency", bullets:[
        `Post consistently using your three pillars: ${pillarNames}.`,
        "Reply to every comment for the first two weeks to train engagement.",
        "Track which pillar gets the most genuine replies, not just likes."
      ]},
      { title:"Expand Your Reach", goal:"Growth", bullets:[
        "Try one collaboration, comment-marketing push, or guest appearance.",
        "Double down on the content format that performed best in week 2.",
        "Start a simple newsletter to own your audience beyond the algorithm."
      ]},
      { title:"Convert & Reflect", goal:"Momentum", bullets:[
        "Add one clear call-to-action (newsletter, booking link, offer) to your bio.",
        "Review what actually built trust vs. what just got views.",
        "Plan month two around your single best-performing pillar."
      ]}
    ];
  }
  return [
    { title:"Lay the Foundation", goal:"Foundation", bullets:[
      `Audit and align your profiles across ${platNames} — one consistent look and voice.`,
      `Publish first posts in each of your three pillars: ${pillarNames}.`,
      `Clarify your core message for ${brand.audience}.`
    ]},
    { title:"Build Momentum", goal:"Consistency", bullets:[
      "Post on a steady, sustainable cadence — not a burst you can't maintain.",
      "Engage with every comment and message to build early trust.",
      "Start collecting simple performance data on each pillar."
    ]},
    { title:"Expand Reach", goal:"Growth", bullets:[
      "Test one trend-driven or collaborative post to reach new audiences.",
      "Highlight a real customer story or review as social proof.",
      "Review early data and shift effort toward what's resonating."
    ]},
    { title:"Convert & Reflect", goal:"Momentum", bullets:[
      "Introduce a clear, low-pressure call-to-action tied to your offer.",
      "Review the full month: what drove trust vs. what drove sales.",
      `Plan month two by doubling down on the strongest pillar for ${brand.challenge.toLowerCase()}`
    ]}
  ];
}

function claudePrompt(kind, brand, mode, extra){
  const who = mode==="personal" ? `my personal brand as a ${brand.industry} expert named ${brand.name}` : `${brand.name}, a ${brand.industry} serving ${brand.audience}`;
  if(kind==="audience"){
    return `Help me define the target audience for ${who}. Ask me clarifying questions about their pain points and goals, then summarize the audience in one clear paragraph I can reuse in my marketing plan.`;
  }
  if(kind==="platforms"){
    return `I'm working on ${who}. I'm considering these platforms: ${extra}. For each one, explain the pros and cons for my specific audience, then recommend which 2-3 I should focus on first and why.`;
  }
  if(kind==="pillars"){
    return `I've chosen these three content pillars for ${who}: ${extra}. Give me five post ideas for each pillar that fit my brand's voice and goals.`;
  }
  if(kind==="roadmap"){
    return `Create a detailed week-by-week content calendar for ${who}, based on this 30-day strategic roadmap:\n${extra}\nInclude specific post ideas and suggested formats for each week.`;
  }
  if(kind==="event"){
    return `${mode==="personal" ? "I" : "My brand"} just experienced this situation: "${extra.title}" I chose to respond by: "${extra.choice}". Help me draft the actual post or message for this response, matching ${mode==="personal" ? "my" : "the brand's"} voice.`;
  }
  return "";
}

