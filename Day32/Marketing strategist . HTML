function PlatformStep({ brand, mode, onNext }){
  const [picked, setPicked] = useState([]);
  const MAX = 3;
  function toggle(p){
    if(picked.includes(p.id)) setPicked(picked.filter(id=>id!==p.id));
    else if(picked.length<MAX) setPicked([...picked, p.id]);
  }
  const chosenPlatforms = PLATFORMS.filter(p=>picked.includes(p.id));
  return (
    <div>
      <div className="card">
        <div className="eyebrow">Step 3 — Choose Platforms</div>
        <h2>Where should {mode==="personal" ? brand.name.split(" ")[0] : brand.name} show up?</h2>
        <p>Pick up to {MAX} platforms. Being everywhere at once is a common beginner mistake — strategists
        pick a few channels on purpose and go deep, instead of spreading thin.</p>
        <div className="select-grid">
          {PLATFORMS.map(p=>{
            const score = fitScore(p, mode);
            const isPicked = picked.includes(p.id);
            const disabled = !isPicked && picked.length>=MAX;
            return (
              <div key={p.id} className={"opt-card " + (isPicked?"picked ":"") + (disabled?"disabled":"")} onClick={()=>!disabled && toggle(p)}>
                <div className="opt-top">
                  <div>
                    <div className="opt-name">{p.name}</div>
                    <div style={{fontSize:12,color:"var(--ink-faint)"}}>{p.blurb}</div>
                  </div>
                  <div className="checkmark">{isPicked ? "✓" : ""}</div>
                </div>
                <div className="fit-bar"><div className="fit-bar-fill" style={{width:(score*20)+"%"}}></div></div>
                <p className="opt-desc">{mode==="personal" ? p.why.personal : p.why.business}</p>
              </div>
            );
          })}
        </div>
        <div className="selection-counter">Selected <b>{picked.length}</b> / {MAX}</div>
      </div>
      <ClaudeCard prompt={claudePrompt("platforms", brand, mode, PLATFORMS.map(p=>p.name).join(", "))} />
      <div className="btn-row">
        <button className="btn" disabled={picked.length===0} onClick={()=>onNext(chosenPlatforms)}>Choose Content Pillars →</button>
      </div>
    </div>
  );
}

