function EventStep({ brand, mode, onNext }){
  const pool = mode==="personal" ? EVENTS_PERSONAL : EVENTS_BUSINESS;
  const [event] = useState(()=>pick(pool));
  const [chosenIdx, setChosenIdx] = useState(null);
  const chosenOption = chosenIdx!==null ? event.options[chosenIdx] : null;
  return (
    <div>
      <div className="card">
        <div className="eyebrow">Step 6 — The Unexpected</div>
        <h2>Something just happened</h2>
        <p>Real strategy isn't just planning — it's how you react when the plan meets reality.</p>
        <div className="event-banner">
          <div className="tag">{event.tag}</div>
          <h3 style={{margin:0}}>{event.title}</h3>
        </div>
        <div className="response-list">
          {event.options.map((opt,i)=>(
            <div key={i} className={"response-opt " + (chosenIdx===i?"chosen":"")} onClick={()=>setChosenIdx(i)}>
              <div className="rtitle">{opt.label}</div>
              {chosenIdx===i && <div className="rdesc consequence">{opt.consequence}</div>}
            </div>
          ))}
        </div>
      </div>
      {chosenOption && (
        <ClaudeCard prompt={claudePrompt("event", brand, mode, {title:event.title, choice:event.options[chosenIdx].label})} />
      )}
      <div className="btn-row">
        <button className="btn" disabled={chosenIdx===null} onClick={()=>onNext(event, chosenOption)}>See Your Growth Report →</button>
      </div>
    </div>
  );
}

function GrowthReport({ brand, mode, platforms, pillars, event, eventOption, onRestart }){
  const isPersonal = mode==="personal";
  const lessonsPool = isPersonal ? LESSONS_PERSONAL : LESSONS_BUSINESS;

  const platformFitAvg = platforms.length
    ? platforms.reduce((s,p)=>s+fitScore(p,mode),0)/platforms.length : 0;
  const pillarBonus = pillars.length===3 ? 1 : 0;
  const eventScore = eventOption ? eventOption.score : 0;
  const rawScore = platformFitAvg + pillarBonus + eventScore; // roughly -1..8
  const pct = Math.max(6, Math.min(100, Math.round(((rawScore+2)/9)*100)));
  const growthLabel = pct>=75 ? "High" : pct>=45 ? "Medium" : "Low";

  const bestPlatform = platforms.slice().sort((a,b)=>fitScore(b,mode)-fitScore(a,mode))[0];
  const worstPlatform = platforms.slice().sort((a,b)=>fitScore(a,mode)-fitScore(b,mode))[0];

  let bestDecision, biggestMistake;
  if(eventOption && eventOption.score>=2){
    bestDecision = `How you handled "${event.tag}" — choosing to "${eventOption.label}". ${eventOption.consequence}`;
  } else if(bestPlatform){
    bestDecision = `Choosing ${bestPlatform.name} as a core channel — it's a strong fit for ${isPersonal?"your niche":"this audience"}: ${isPersonal?bestPlatform.why.personal:bestPlatform.why.business}`;
  } else {
    bestDecision = "Committing to exactly three content pillars instead of scattering effort across everything.";
  }
  if(eventOption && eventOption.score<0){
    biggestMistake = `The response to "${event.tag}" — "${eventOption.label}." ${eventOption.consequence}`;
  } else if(worstPlatform && fitScore(worstPlatform,mode)<=2){
    biggestMistake = `Including ${worstPlatform.name} in the core channel mix — it's a weaker fit here: ${isPersonal?worstPlatform.why.personal:worstPlatform.why.business}`;
  } else {
    biggestMistake = "Not yet defining a single measurable goal (followers, leads, or sales) to point this whole strategy at.";
  }

  const lessons = useMemo(()=>{
    const shuffled = lessonsPool.slice().sort(()=>Math.random()-0.5);
    return shuffled.slice(0,3);
  }, [mode]);

  return (
    <div>
      <div className="card tilt">
        <div className="pin"></div>
        <div className="eyebrow">Growth Report</div>
        <h1>{brand.name}'s Strategy, Scored</h1>
        <p className="lede">Here's how the choices you made throughout this simulation add up.</p>

        <div className="report-card full" style={{marginTop:6}}>
          <div className="k">Growth Potential</div>
          <div className="growth-meter">
            <div className="growth-track"><div className="growth-fill" style={{width:pct+"%"}}></div></div>
            <div className="growth-label">{growthLabel}</div>
          </div>
        </div>

        <div className="report-grid">
          <div className="report-card">
            <div className="k">Audience Understanding</div>
            <p>{isPersonal ? "You" : brand.name} are speaking to <b>{brand.audience}</b>, facing: {brand.challenge}</p>
          </div>
          <div className="report-card">
            <div className="k">Platform Strategy</div>
            <p>Focused on {platforms.map(p=>p.name).join(", ") || "no platforms selected"} — avoiding the trap of trying to be everywhere at once.</p>
          </div>
          <div className="report-card">
            <div className="k">Content Strategy</div>
            <p>Built around three pillars: {pillars.map(p=>p.name).join(", ") || "none selected"} — each serving a different goal.</p>
          </div>
          <div className="report-card">
            <div className="k">Best Decision</div>
            <p>{bestDecision}</p>
          </div>
          <div className="report-card full">
            <div className="k">Biggest Mistake</div>
            <p>{biggestMistake}</p>
          </div>
          <div className="report-card full">
            <div className="k">Three Marketing Lessons</div>
            <ul className="lesson-list">
              {lessons.map((l,i)=>(
                <li key={i}><span className="num">{String(i+1).padStart(2,"0")}</span><span>{l}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div className="btn-row">
        <button className="btn" onClick={onRestart}>🎲 Start a New Simulation</button>
      </div>
    </div>
  );
}

/* ============================= APP ============================= */

const STEP_LABELS_BIZ = ["Brand","Audience","Platforms","Pillars","Roadmap","Curveball","Report"];

function App(){
  const [stage, setStage] = useState("welcome");
  const [mode, setMode] = useState(null); // "business" | "personal"
  const [brand, setBrand] = useState(null);
  const [platforms, setPlatforms] = useState([]);
  const [pillars, setPillars] = useState([]);
  const [event, setEvent] = useState(null);
  const [eventOption, setEventOption] = useState(null);

  function resetAll(){
    setStage("welcome"); setMode(null); setBrand(null);
    setPlatforms([]); setPillars([]); setEvent(null); setEventOption(null);
  }

  function handlePathPick(choice){
    if(choice==="business-manual"){ setMode("business"); setStage("form"); }
    else if(choice==="personal-manual"){ setMode("personal"); setStage("form"); }
    else { setStage("random-type"); }
  }
  function handleRandomType(type){
    setMode(type);
    setBrand(type==="personal" ? randomPersonal() : randomBusiness());
    setStage("audience");
  }
  function handleFormSubmit(data){
    setBrand(data);
    setStage("audience");
  }

  const stepIndex = ["form","audience","platforms","pillars","roadmap","event","report"].indexOf(stage);

  return (
    <div className="app-shell">
      <div className="brandbar">
        <div className="logo">
          <div className="pin-dot"></div>
          <div className="logo-text"><b>Marketing Strategist</b> · Grow This Brand</div>
        </div>
        {stage!=="welcome" && <button className="replay-btn" onClick={resetAll}>↺ Restart</button>}
      </div>

      {stage!=="welcome" && stage!=="path" && stage!=="random-type" && stage!=="form" && (
        <Rail stepIndex={Math.max(stepIndex,0)} steps={STEP_LABELS_BIZ} />
      )}

      {stage==="welcome" && <Welcome onStart={()=>setStage("path")} />}
      {stage==="path" && <PathChooser onPick={handlePathPick} />}
      {stage==="random-type" && <RandomTypeChooser onPick={handleRandomType} />}
      {stage==="form" && <BusinessForm mode={mode} onSubmit={handleFormSubmit} />}

      {stage==="audience" && brand && (
        <AudienceStep brand={brand} mode={mode} onNext={()=>setStage("platforms")} />
      )}
      {stage==="platforms" && brand && (
        <PlatformStep brand={brand} mode={mode} onNext={(p)=>{ setPlatforms(p); setStage("pillars"); }} />
      )}
      {stage==="pillars" && brand && (
        <PillarStep brand={brand} mode={mode} onNext={(p)=>{ setPillars(p); setStage("roadmap"); }} />
      )}
      {stage==="roadmap" && brand && (
        <RoadmapStep brand={brand} mode={mode} platforms={platforms} pillars={pillars} onNext={()=>setStage("event")} />
      )}
      {stage==="event" && brand && (
        <EventStep brand={brand} mode={mode} onNext={(ev, opt)=>{ setEvent(ev); setEventOption(opt); setStage("report"); }} />
      )}
      {stage==="report" && brand && (
        <GrowthReport brand={brand} mode={mode} platforms={platforms} pillars={pillars}
          event={event} eventOption={eventOption} onRestart={resetAll} />
      )}

      <div className="footer-note">Runs fully offline · No data leaves your browser · Replay anytime for a new brand</div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
