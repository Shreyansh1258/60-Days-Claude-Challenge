<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Think Like a Marketing Strategist: Grow This Brand</title>
<style>
  :root{
    --bg:#0a0c11;
    --bg-alt:#10131a;
    --card:#151a24;
    --card-border:#262c3a;
    --ink:#eef1f6;
    --ink-dim:#93a0b8;
    --ink-faint:#5e6980;
    --accent:#ffb545;
    --accent-ink:#1a1400;
    --accent2:#ff5d8f;
    --accent3:#57e0c5;
    --danger:#ff6b6b;
    --line: rgba(255,255,255,0.08);
    --dot: rgba(255,255,255,0.055);
    --radius: 14px;
    --serif-display: Georgia, 'Iowan Old Style', 'Palatino Linotype', Palatino, serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
  }
  *{ box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    background:
      radial-gradient(circle at 1px 1px, var(--dot) 1.4px, transparent 1.4px) 0 0/22px 22px,
      radial-gradient(1200px 700px at 15% -10%, rgba(255,181,69,0.08), transparent 60%),
      radial-gradient(1000px 600px at 100% 0%, rgba(255,93,143,0.07), transparent 55%),
      var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
  }
  #root{ min-height:100vh; display:flex; flex-direction:column; }
  ::selection{ background:var(--accent); color:var(--accent-ink); }
  button{ font-family:inherit; }

  .app-shell{ max-width:980px; margin:0 auto; width:100%; padding:28px 20px 80px; flex:1; }

  .brandbar{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:22px; flex-wrap:wrap; }
  .brandbar .logo{ display:flex; align-items:center; gap:10px; }
  .pin-dot{ width:11px; height:11px; border-radius:50%; background:var(--accent2); box-shadow:0 0 0 3px rgba(255,93,143,0.18); flex-shrink:0; }
  .logo-text{ font-family:var(--serif-display); font-size:15px; letter-spacing:0.4px; color:var(--ink-dim); }
  .logo-text b{ color:var(--ink); font-weight:700; }
  .replay-btn{
    background:transparent; border:1px solid var(--card-border); color:var(--ink-dim);
    padding:8px 14px; border-radius:999px; font-size:12.5px; cursor:pointer; letter-spacing:0.3px;
    transition:all .15s ease;
  }
  .replay-btn:hover{ border-color:var(--accent); color:var(--accent); }

  /* ---- progress rail ---- */
  .rail{ display:flex; align-items:center; gap:0; margin:0 0 30px; overflow-x:auto; padding-bottom:4px; }
  .rail-step{ display:flex; align-items:center; flex-shrink:0; }
  .rail-node{
    width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-family:var(--mono); font-size:11px; border:1.5px solid var(--card-border); color:var(--ink-faint);
    background:var(--bg-alt); transition:all .25s ease; flex-shrink:0;
  }
  .rail-node.done{ background:var(--accent3); border-color:var(--accent3); color:#052620; }
  .rail-node.current{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); box-shadow:0 0 0 4px rgba(255,181,69,0.16); }
  .rail-label{ font-size:10.5px; color:var(--ink-faint); margin-left:7px; margin-right:14px; white-space:nowrap; letter-spacing:0.2px; }
  .rail-label.active{ color:var(--ink-dim); }
  .rail-connector{ width:22px; height:1px; background:var(--card-border); margin-right:14px; flex-shrink:0; }

  /* ---- cards ---- */
  .card{
    background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius);
    padding:26px 26px; position:relative; margin-bottom:18px;
    animation: rise .35s ease;
  }
  @keyframes rise{ from{ opacity:0; transform:translateY(8px);} to{ opacity:1; transform:translateY(0);} }
  .pin{
    position:absolute; top:-9px; left:26px; width:16px; height:16px; border-radius:50%;
    background:var(--accent2); box-shadow:0 3px 6px rgba(0,0,0,0.4);
  }
  .card.tilt{ transform:rotate(-0.35deg); }

  .eyebrow{ font-family:var(--mono); font-size:11px; letter-spacing:1.6px; text-transform:uppercase; color:var(--accent); margin:0 0 8px; }
  h1{ font-family:var(--serif-display); font-weight:700; font-size:clamp(26px,4vw,38px); line-height:1.12; margin:0 0 14px; letter-spacing:-0.3px; }
  h2{ font-family:var(--serif-display); font-weight:700; font-size:clamp(20px,3vw,26px); line-height:1.2; margin:0 0 10px; }
  h3{ font-size:15px; margin:0 0 6px; letter-spacing:0.2px; }
  p{ color:var(--ink-dim); line-height:1.65; font-size:15px; margin:0 0 12px; }
  .lede{ font-size:16.5px; color:var(--ink-dim); line-height:1.7; }

  .callout{
    background:var(--bg-alt); border:1px solid var(--line); border-left:3px solid var(--accent);
    border-radius:10px; padding:14px 16px; margin:14px 0;
  }
  .callout .k{ font-family:var(--mono); font-size:10.5px; letter-spacing:1.2px; text-transform:uppercase; color:var(--accent); margin-bottom:4px; }
  .callout p{ margin:0; font-size:14px; color:var(--ink); }

  .why-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:16px; }
  @media (max-width:640px){ .why-grid{ grid-template-columns:1fr; } }
  .why-box{ background:var(--bg-alt); border:1px solid var(--line); border-radius:10px; padding:14px 16px; }
  .why-box .k{ font-family:var(--mono); font-size:10.5px; letter-spacing:1px; text-transform:uppercase; color:var(--ink-faint); margin-bottom:6px; }
  .why-box.what .k{ color:var(--accent3); }
  .why-box.why .k{ color:var(--accent2); }
  .why-box p{ margin:0; font-size:13.8px; }

  /* buttons */
  .btn{
    background:var(--accent); color:var(--accent-ink); border:none; border-radius:10px;
    padding:12px 22px; font-size:14.5px; font-weight:700; cursor:pointer; letter-spacing:0.2px;
    transition:transform .12s ease, box-shadow .12s ease;
  }
  .btn:hover{ transform:translateY(-1px); box-shadow:0 6px 18px rgba(255,181,69,0.22); }
  .btn:disabled{ opacity:0.35; cursor:not-allowed; transform:none; box-shadow:none; }
  .btn.ghost{ background:transparent; color:var(--ink); border:1px solid var(--card-border); }
  .btn.ghost:hover{ border-color:var(--ink-dim); box-shadow:none; }
  .btn.small{ padding:8px 14px; font-size:13px; }
  .btn-row{ display:flex; gap:12px; margin-top:20px; flex-wrap:wrap; }

  /* choice cards (path picker) */
  .path-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:22px; }
  @media (max-width:760px){ .path-grid{ grid-template-columns:1fr; } }
  .path-card{
    background:var(--bg-alt); border:1px solid var(--card-border); border-radius:var(--radius);
    padding:22px 18px; cursor:pointer; text-align:left; transition:all .15s ease; position:relative;
  }
  .path-card:hover{ border-color:var(--accent); transform:translateY(-3px); }
  .path-emoji{ font-size:28px; margin-bottom:10px; display:block; }
  .path-card h3{ margin-bottom:6px; }
  .path-card p{ font-size:13.5px; margin:0; }

  /* forms */
  .field{ margin-bottom:16px; }
  .field label{ display:block; font-size:12.5px; color:var(--ink-faint); margin-bottom:6px; font-family:var(--mono); letter-spacing:0.3px; }
  .field input, .field textarea{
    width:100%; background:var(--bg); border:1px solid var(--card-border); border-radius:9px;
    padding:11px 13px; color:var(--ink); font-size:14.5px; font-family:var(--sans);
  }
  .field input:focus, .field textarea:focus{ outline:none; border-color:var(--accent); }
  .field textarea{ resize:vertical; min-height:64px; }
  .two-col{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media (max-width:640px){ .two-col{ grid-template-columns:1fr; } }

  .stat-strip{ display:flex; flex-wrap:wrap; gap:10px; margin:16px 0 4px; }
  .stat-chip{ background:var(--bg-alt); border:1px solid var(--line); border-radius:8px; padding:9px 13px; font-size:12.5px; }
  .stat-chip .k{ font-family:var(--mono); color:var(--ink-faint); text-transform:uppercase; letter-spacing:0.6px; font-size:10px; display:block; margin-bottom:3px; }
  .stat-chip .v{ color:var(--ink); font-weight:600; }

  /* platform / pillar selection grids */
  .select-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:18px; }
  @media (max-width:700px){ .select-grid{ grid-template-columns:1fr; } }
  .opt-card{
    background:var(--bg-alt); border:1.5px solid var(--card-border); border-radius:12px; padding:16px 17px;
    cursor:pointer; transition:all .15s ease; position:relative;
  }
  .opt-card:hover{ border-color:var(--ink-faint); }
  .opt-card.picked{ border-color:var(--accent3); background:rgba(87,224,197,0.06); }
  .opt-card.disabled{ opacity:0.4; cursor:not-allowed; }
  .opt-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:6px; }
  .opt-name{ font-weight:700; font-size:15px; }
  .checkmark{ width:20px; height:20px; border-radius:50%; border:1.5px solid var(--card-border); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:11px; }
  .opt-card.picked .checkmark{ background:var(--accent3); border-color:var(--accent3); color:#052620; }
  .fit-bar{ height:5px; border-radius:3px; background:var(--card-border); margin:8px 0 10px; overflow:hidden; }
  .fit-bar-fill{ height:100%; background:var(--accent); border-radius:3px; }
  .opt-desc{ font-size:13.3px; color:var(--ink-dim); margin:0; line-height:1.55; }
  .goal-tag{ display:inline-block; font-family:var(--mono); font-size:10px; letter-spacing:0.6px; text-transform:uppercase; color:var(--accent2); background:rgba(255,93,143,0.1); padding:3px 8px; border-radius:5px; margin-top:8px; }

  .selection-counter{ font-family:var(--mono); font-size:12.5px; color:var(--ink-faint); margin-top:14px; }
  .selection-counter b{ color:var(--accent); }

  /* claude prompt card */
  .claude-card{ background:linear-gradient(160deg, rgba(255,181,69,0.07), rgba(255,93,143,0.05)); border:1px dashed rgba(255,181,69,0.35); border-radius:12px; padding:18px 20px; margin-top:22px; }
  .claude-card .cc-head{ display:flex; align-items:center; gap:8px; margin-bottom:10px; }
  .claude-badge{ width:22px; height:22px; border-radius:6px; background:var(--accent); color:var(--accent-ink); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; flex-shrink:0; }
  .claude-card .cc-title{ font-size:13px; font-weight:700; letter-spacing:0.2px; }
  .prompt-box{
    background:var(--bg); border:1px solid var(--card-border); border-radius:9px; padding:13px 15px;
    font-family:var(--mono); font-size:12.6px; color:var(--ink-dim); line-height:1.6; white-space:pre-wrap;
  }
  .copy-btn{ margin-top:10px; }

  /* roadmap */
  .week-track{ display:flex; flex-direction:column; gap:14px; margin-top:18px; }
  .week-card{ background:var(--bg-alt); border:1px solid var(--line); border-radius:12px; padding:18px 20px; display:flex; gap:18px; }
  .week-num{ font-family:var(--serif-display); font-size:30px; color:var(--accent); flex-shrink:0; width:52px; }
  .week-body h3{ margin-bottom:4px; }
  .week-goal{ font-family:var(--mono); font-size:11px; color:var(--accent3); text-transform:uppercase; letter-spacing:0.6px; margin-bottom:8px; }
  .week-body ul{ margin:0; padding-left:18px; }
  .week-body li{ font-size:13.6px; color:var(--ink-dim); margin-bottom:5px; line-height:1.55; }
  @media (max-width:600px){ .week-card{ flex-direction:column; gap:6px; } .week-num{ width:auto; } }

  /* event */
  .event-banner{ background:linear-gradient(120deg, rgba(255,93,143,0.12), rgba(255,181,69,0.08)); border:1px solid rgba(255,93,143,0.3); border-radius:12px; padding:20px 22px; margin:14px 0 20px; }
  .event-banner .tag{ font-family:var(--mono); font-size:11px; color:var(--accent2); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px; }
  .response-list{ display:flex; flex-direction:column; gap:10px; margin-top:16px; }
  .response-opt{ text-align:left; background:var(--bg-alt); border:1.5px solid var(--card-border); border-radius:10px; padding:14px 16px; cursor:pointer; transition:all .15s ease; }
  .response-opt:hover{ border-color:var(--accent); }
  .response-opt.chosen{ border-color:var(--accent3); background:rgba(87,224,197,0.07); }
  .response-opt .rtitle{ font-weight:700; font-size:14px; margin-bottom:3px; }
  .response-opt .rdesc{ font-size:13px; color:var(--ink-dim); }
  .consequence{ margin-top:16px; }

  /* report */
  .report-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:20px; }
  @media (max-width:700px){ .report-grid{ grid-template-columns:1fr; } }
  .report-card{ background:var(--bg-alt); border:1px solid var(--line); border-radius:12px; padding:17px 19px; }
  .report-card.full{ grid-column:1/-1; }
  .report-card .k{ font-family:var(--mono); font-size:10.5px; letter-spacing:1px; text-transform:uppercase; color:var(--accent); margin-bottom:8px; }
  .report-card p{ margin:0; font-size:14px; color:var(--ink); }
  .growth-meter{ display:flex; align-items:center; gap:10px; margin-top:6px; }
  .growth-track{ flex:1; height:8px; background:var(--card-border); border-radius:5px; overflow:hidden; }
  .growth-fill{ height:100%; border-radius:5px; background:linear-gradient(90deg, var(--accent2), var(--accent)); transition:width .6s ease; }
  .growth-label{ font-family:var(--mono); font-size:12px; color:var(--accent); flex-shrink:0; }
  .lesson-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
  .lesson-list li{ background:var(--bg); border:1px solid var(--line); border-radius:9px; padding:12px 14px; font-size:13.8px; color:var(--ink-dim); display:flex; gap:10px; }
  .lesson-list .num{ font-family:var(--mono); color:var(--accent); flex-shrink:0; }

  .footer-note{ text-align:center; color:var(--ink-faint); font-size:12px; margin-top:34px; font-family:var(--mono); }

  .tag-row{ display:flex; flex-wrap:wrap; gap:8px; margin-top:6px; }
  .mini-tag{ font-family:var(--mono); font-size:11.5px; background:var(--bg); border:1px solid var(--line); padding:5px 10px; border-radius:7px; color:var(--ink-dim); }
</style>
</head>
<body>
<div id="root"></div>

<script src="https://unpkg.com/react@18/umd/react.development.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

<script type="text/babel">
const { useState, useMemo } = React;

/* ============================= DATA ============================= */

const INDUSTRIES = [
  "Cold-Brew Coffee Roaster","Sustainable Sneaker Brand","Boutique Pet Grooming Studio",
  "Plant-Based Meal Kit Service","Handmade Ceramics Studio","Kids' Coding Bootcamp",
  "Vintage Furniture Restorer","Local Craft Brewery","Mobile Car Detailing Service",
  "Indie Skincare Line","Budget Travel Planning App","Urban Vertical Farm"
];
const AUDIENCES = [
  "busy young professionals who value convenience",
  "eco-conscious millennials with disposable income",
  "new parents looking for trustworthy recommendations",
  "Gen Z students on tight budgets",
  "small business owners who need fast solutions",
  "fitness enthusiasts chasing performance gains",
  "retirees exploring new hobbies",
  "remote workers craving community"
];
const BUDGETS = [
  "$500/month (bootstrapped)","$2,000/month (small but steady)",
  "$10,000/month (growth-stage)","$50,000/month (backed by investors)"
];
const COMPETITORS = [
  "a fast-growing DTC startup with viral TikToks",
  "a legacy brand with loyal but aging customers",
  "three scrappy local competitors undercutting on price",
  "an influencer-backed brand with huge reach but shallow trust"
];
const CHALLENGES = [
  "Nobody knows the brand exists yet.",
  "Sales are fine but growth has stalled for six months.",
  "A competitor just went viral and stole the spotlight.",
  "Customers love the product but rarely come back twice.",
  "The last marketing hire left and there's no clear strategy."
];

const NICHES = [
  "career coaching for career-switchers","personal finance for freelancers",
  "no-code app development","sustainable home design","B2B SaaS sales strategy",
  "mental health for entrepreneurs","urban gardening","independent filmmaking"
];
const INSPIRATIONS = [
  "a writer known for blunt, no-fluff advice",
  "a creator who built a movement around one big idea",
  "a practitioner-turned-teacher with a small but devoted audience",
  "a former skeptic who now leads the conversation in this space"
];
const PERSONAL_CHALLENGES = [
  "Nobody outside your close circle knows what you actually do.",
  "You post sometimes but nothing seems to land.",
  "You have expertise but no clear niche or angle.",
  "You're inconsistent — bursts of posting, then silence for weeks.",
  "You have followers but no real trust or inbound opportunities."
];

function pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }

function randomBusiness(){
  return {
    type:"business",
    name: pick(["Nova & Co.","Basecamp Goods","The Daily Roast","Fernweh Studio","Greenline","Kindred Supply","Northbound","Little Anchor"]),
    industry: pick(INDUSTRIES),
    audience: pick(AUDIENCES),
    budget: pick(BUDGETS),
    competitors: pick(COMPETITORS),
    challenge: pick(CHALLENGES)
  };
}
function randomPersonal(){
  return {
    type:"personal",
    name: pick(["Maya Chen","Diego Alvarez","Priya Nair","Sam O'Connell","Zoe Baptiste","Malik Freeman"]),
    industry: pick(NICHES),
    audience: pick(AUDIENCES),
    budget: pick(["a few hours a week, solo","5 hrs/week + occasional freelance help","a small team helping part-time"]),
    competitors: pick(INSPIRATIONS),
    challenge: pick(PERSONAL_CHALLENGES)
  };
}

const PLATFORMS = [
  { id:"instagram", name:"Instagram", blurb:"Visual storytelling, Reels & Stories",
    fit:{business:5, personal:3},
    why:{
      business:"Strong for visually appealing products — photos, Reels, and Stories build desire fast.",
      personal:"Useful for casual behind-the-scenes moments, but it rewards visuals over ideas."
    }},
  { id:"tiktok", name:"TikTok", blurb:"Short-form video, trend-driven reach",
    fit:{business:4, personal:3},
    why:{
      business:"Best-in-class for discovery — the algorithm can hand you an audience you don't have yet.",
      personal:"Great for reach and personality, but it favors entertainment over deep expertise."
    }},
  { id:"linkedin", name:"LinkedIn", blurb:"Professional network, long-form posts",
    fit:{business:3, personal:5},
    why:{
      business:"Solid for B2B credibility and hiring, weaker for consumer-facing product sales.",
      personal:"One of the best places to build authority — text posts travel far with the right POV."
    }},
  { id:"twitter", name:"X / Twitter", blurb:"Real-time conversation, threads",
    fit:{business:2, personal:5},
    why:{
      business:"Fast-moving and hard to sustain for a product brand without a strong voice.",
      personal:"Perfect for sharing sharp opinions and joining live conversations in your niche."
    }},
  { id:"youtube", name:"YouTube", blurb:"Long-form video, searchable & evergreen",
    fit:{business:3, personal:4},
    why:{
      business:"Great for tutorials and product demos, but requires real production time.",
      personal:"Builds deep trust through long-form teaching — content keeps working for years."
    }},
  { id:"facebook", name:"Facebook", blurb:"Groups, local reach, older demographics",
    fit:{business:3, personal:2},
    why:{
      business:"Still useful for local businesses and community groups, less so for younger audiences.",
      personal:"Rarely where a personal brand grows fastest today, unless your audience skews older."
    }},
  { id:"newsletter", name:"Newsletter / Email", blurb:"Owned audience, no algorithm",
    fit:{business:4, personal:5},
    why:{
      business:"You own this list — no algorithm can take it away. Best channel for repeat customers.",
      personal:"The backbone of a durable personal brand — direct access to people who trust you."
    }}
];

const BUSINESS_PILLARS = [
  { id:"education", name:"Educational Content", goal:"Trust", desc:"Teach your audience something useful about your product or industry." },
  { id:"bts", name:"Behind-the-Scenes", goal:"Connection", desc:"Show the process, people, and craft behind the brand." },
  { id:"social_proof", name:"Social Proof", goal:"Trust", desc:"Reviews, testimonials, and real customer stories." },
  { id:"product", name:"Product Spotlight", goal:"Conversion", desc:"Showcase features, use-cases, and new drops." },
  { id:"trend", name:"Trend & Entertainment", goal:"Awareness", desc:"Light, fun content that rides platform trends." },
  { id:"community", name:"Community & UGC", goal:"Loyalty", desc:"Feature your customers and invite participation." },
  { id:"promo", name:"Promotions & Offers", goal:"Conversion", desc:"Direct calls-to-action, discounts, and launches." }
];
const PERSONAL_PILLARS = [
  { id:"thought", name:"Thought Leadership", goal:"Authority", desc:"Share your point of view on where your field is headed." },
  { id:"story", name:"Personal Story", goal:"Connection", desc:"The journey, failures, and turning points that shaped you." },
  { id:"bts", name:"Behind the Scenes", goal:"Trust", desc:"How you actually work, day to day." },
  { id:"education", name:"Audience Education", goal:"Authority", desc:"Teach one concept from your expertise, simply." },
  { id:"case", name:"Case Studies & Wins", goal:"Conversion", desc:"Concrete results you or your clients have achieved." },
  { id:"hottake", name:"Hot Takes", goal:"Awareness", desc:"Respectfully challenge a common belief in your niche." }
];

const EVENTS_BUSINESS = [
  { id:"viral", tag:"Sudden Virality", title:"A short video about your product suddenly goes viral overnight — 2M views and climbing.",
    options:[
      { label:"Post a fast follow-up while attention is hot", score:2, consequence:"Smart move — momentum is a resource with a short shelf life. The follow-up post captures new followers before the algorithm moves on, turning a lucky spike into a real audience bump." },
      { label:"Pause posting and let the moment 'breathe'", score:-1, consequence:"Attention faded fast. Without a follow-up, most of the new eyes never became followers or customers — a classic missed window." },
      { label:"Immediately run paid ads to the viral post", score:0, consequence:"A reasonable instinct, but without a clear offer or landing page ready, the extra spend mostly padded vanity metrics rather than converting." }
    ]},
  { id:"copy", tag:"Competitor Copies You", title:"A competitor copies your signature campaign idea almost exactly, days after you launched it.",
    options:[
